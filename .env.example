# Snag — Hermes build. Copy to .env and fill in. NEVER commit the real .env.

# --- Required to run the bot ---
TELEGRAM_BOT_TOKEN=        # from @BotFather (/newbot). This is the @tttest75bot token.
DEEPSEEK_API_KEY=          # api.deepseek.com key (analysis + triage, text-only)

# --- Model (text-only strategy for v1) ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Optional: robust download (TikTok and other non-YouTube video) ---
SCRAPECREATORS_API_KEY=    # scrapecreators.com — primary downloader
SCRAPTIK_API_KEY=          # RapidAPI ScrapTik — failover for region-locked/10240

# --- Billing (needed for /upgrade + Pro) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=           # the recurring Pro price (e.g. price_123)
PUBLIC_BASE_URL=           # https host for Stripe success/cancel + webhook

# --- Tunables (have sane defaults) ---
FREE_MONTHLY_LIMIT=10
FREE_MAX_VIDEO_SECONDS=180
BRAND_NAME=Snag

# --- Notes ---
# v1 model strategy is text-only. No vision, no multimodal video upload. This is
# what keeps cost low (the old Gemini build sent full videos to a multimodal
# model on every capture, which is what drove billing up).
#
# Transcription is free: YouTube native captions (yt-dlp) and local
# faster-whisper for downloaded/uploaded files. No paid STT dependency.
