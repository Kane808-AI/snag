<?xml version="1.0" encoding="UTF-8"?>
<!--
  Snag web frontend (production TanStack Start build, served by Node).
  Binds 127.0.0.1:8080; fetches the API cross-origin from localhost:8476.

  Install:
    cp deploy/com.hermes.snag-web.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hermes.snag-web.plist
  Restart:
    launchctl kickstart -k gui/$(id -u)/com.hermes.snag-web

  NOTE: requires web/.output/ to exist. Run `cd web && bun run build`
  after any frontend source change, then restart this service.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hermes.snag-web</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/chriskaneshiro/.hermes/workspace/snag/deploy/run-web.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/chriskaneshiro/.hermes/workspace/snag/logs/web.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/chriskaneshiro/.hermes/workspace/snag/logs/web.err.log</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
